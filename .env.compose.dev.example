# Copy to .env.compose.dev and pass it with --env-file.
# Bundled services: database,redis. Leave empty to use existing services.
# Add ,realtime to also start the optional Reverb WebSocket server.
COMPOSE_PROFILES=database,redis
DEV_UID=1000
DEV_GID=1000
HTTP_BIND=127.0.0.1
HTTP_PORT=8082
VITE_PORT=5173
VITE_HMR_HOST=localhost
APP_KEY=
APP_URL=http://localhost:8082
ADMIN_EMAILS=admin@example.com
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=3
REDIS_PREFIX=backend_lab_dev_
CACHE_PREFIX=backend_lab_dev_cache_
CACHE_STORE=redis
SESSION_DRIVER=file
QUEUE_CONNECTION=redis
MAIL_MAILER=log
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
BROADCAST_CONNECTION=log
REVERB_APP_ID=backend-lab-dev
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_PORT=8083
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8083
REVERB_CLIENT_SCHEME=http
REVERB_SCALING_ENABLED=false
REVERB_ALLOWED_ORIGINS=http://localhost:8082
REVERB_APP_RATE_LIMITING_ENABLED=true
VISITOR_RETENTION_DAYS=30
SESSION_SECURE_COOKIE=false
