# Copy to .env.compose and pass it with --env-file.
# This file is passed as environment variables, never mounted in the image.
# Bundled services: database,redis. Leave empty to use existing services.
# Add ,realtime to also start the optional Reverb WebSocket server.
COMPOSE_PROFILES=database,redis
VERSION=latest
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_KEY=
APP_URL=http://localhost:8080
ADMIN_EMAILS=admin@example.com
TRUSTED_PROXIES=
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
DB_SSLMODE=prefer
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=3
REDIS_PREFIX=backend_lab_
CACHE_PREFIX=backend_lab_cache_
CACHE_STORE=redis
SESSION_DRIVER=file
QUEUE_CONNECTION=redis
MAIL_MAILER=log
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
BROADCAST_CONNECTION=log
REVERB_APP_ID=backend-lab
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_PORT=8081
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8081
REVERB_CLIENT_SCHEME=http
REVERB_SCALING_ENABLED=false
