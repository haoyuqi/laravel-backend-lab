# Copy to .env for docker compose up -d.
# For legacy .env.compose deployments, set COMPOSE_ENV_FILE=.env.compose
# and pass --env-file .env.compose to every command.
COMPOSE_ENV_FILE=.env
# This file is passed as environment variables, never mounted in the image.
# Bundled services: database,redis. Leave empty to use existing services.
# Add ,realtime to also start the optional Reverb WebSocket server.
COMPOSE_PROFILES=database,redis
VERSION=latest
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_KEY=
APP_URL=http://localhost:8080
ADMIN_EMAILS=you@example.com
TRUSTED_PROXIES=
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
DB_SSLMODE=prefer
REDIS_CLIENT=phpredis
# Optional Laravel connection URL; URL values override matching individual fields.
# REDIS_URL=redis://redis.example.internal:6379
REDIS_USERNAME=null
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=3
# Cache, session and queue are independent connections; give each its own host
# when they live on separate servers.
REDIS_SESSION_DB=2
# Keep default for existing queues; choose queue to use REDIS_QUEUE_DB.
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
# Optional per-connection overrides (unset values inherit REDIS_*).
# REDIS_CACHE_URL=
# REDIS_CACHE_HOST=
# REDIS_CACHE_PORT=
# REDIS_CACHE_USERNAME=
# REDIS_CACHE_PASSWORD=
# REDIS_QUEUE_URL=
# REDIS_QUEUE_HOST=
# REDIS_QUEUE_PORT=
# REDIS_QUEUE_USERNAME=
# REDIS_QUEUE_PASSWORD=
# REDIS_SESSION_URL=
# REDIS_SESSION_HOST=
# REDIS_SESSION_PORT=
# REDIS_SESSION_USERNAME=
# REDIS_SESSION_PASSWORD=
REDIS_PREFIX=backend_lab_
CACHE_PREFIX=backend_lab_cache_
CACHE_STORE=redis
# Memcached can back the cache layer instead of Redis. The image bundles the
# memcached PHP extension; point these at any reachable Memcached server.
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211
# MEMCACHED_PERSISTENT_ID=backend_lab_cache
SESSION_DRIVER=file
# Store sessions in Redis by setting driver to redis and pointing at a
# connection: SESSION_CONNECTION=session (uses REDIS_SESSION_* above).
SESSION_CONNECTION=
# Keep false for the loopback HTTP quick start; set true when the public URL is HTTPS behind a TLS proxy.
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
# Set false when backups are managed outside this application.
BACKUP_SCHEDULE_ENABLED=true

MAIL_MAILER=log
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
BROADCAST_CONNECTION=log
REVERB_APP_ID=backend-lab
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_PORT=8081
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8081
REVERB_CLIENT_SCHEME=http
REVERB_SCALING_ENABLED=false
# Comma-separated browser hostnames allowed to open the WebSocket (no scheme/port).
REVERB_ALLOWED_ORIGINS=localhost
REVERB_APP_RATE_LIMITING_ENABLED=true
VISITOR_RETENTION_DAYS=30

# Production Compose networks: leave defaults for bundled dependencies.
# Set *_EXTERNAL=true and supply an existing network name to reuse services.
POSTGRES_NETWORK_EXTERNAL=false
REDIS_NETWORK_EXTERNAL=false
MEMCACHED_NETWORK_EXTERNAL=false
INGRESS_NETWORK_EXTERNAL=false
# POSTGRES_NETWORK=infra-postgres-private
# REDIS_NETWORK=infra-redis-private
# MEMCACHED_NETWORK=infra-memcached-private
# INGRESS_NETWORK=ingress-nginx_default

APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=1.0
BACKGROUND_MEMORY_LIMIT=512m
BACKGROUND_CPU_LIMIT=1.0
REVERB_MEMORY_LIMIT=256m
REVERB_CPU_LIMIT=0.5
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
PHP_MEMORY_LIMIT=256M
PHP_OPCACHE_MEMORY=96
PHP_FPM_MAX_CHILDREN=4
