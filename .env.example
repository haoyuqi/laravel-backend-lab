APP_NAME=Laravel
APP_VERSION=2.1.0
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_EMAILS=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Optional: run the test suite against a real database (defaults to in-memory
# SQLite when unset). Driver must be sqlite / mysql / pgsql.
# TEST_DB_CONNECTION=
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=
# TEST_DB_DATABASE=
# TEST_DB_USERNAME=
# TEST_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log

CACHE_STORE=file

QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

VITE_REDIS_PREFIX=
