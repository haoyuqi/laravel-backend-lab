APP_NAME=Laravel
APP_VERSION=3.1.0
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost

ADMIN_EMAILS=
BACKUP_NOTIFICATION_EMAIL=
TRUSTED_PROXIES=
DEMO_ROUTES_ENABLED=false
# Raw visitor rows and request paths are pruned after this many days.
VISITOR_RETENTION_DAYS=30

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer

# Optional: run the test suite against a real database (defaults to in-memory
# SQLite when unset). Driver must be sqlite / mysql / pgsql.
# TEST_DB_CONNECTION=
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=
# TEST_DB_DATABASE=
# TEST_DB_USERNAME=
# TEST_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log

CACHE_STORE=file

QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database

REDIS_CLIENT=phpredis
# Optional Laravel connection URL; URL values override matching individual fields.
# REDIS_URL=redis://redis.example.internal:6379
REDIS_USERNAME=null
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=3
# Keep default for existing queues; choose queue to use REDIS_QUEUE_DB.
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
# Optional per-connection overrides (unset values inherit REDIS_*).
# REDIS_CACHE_URL=
# REDIS_CACHE_HOST=
# REDIS_CACHE_PORT=
# REDIS_CACHE_USERNAME=
# REDIS_CACHE_PASSWORD=
# REDIS_QUEUE_URL=
# REDIS_QUEUE_HOST=
# REDIS_QUEUE_PORT=
# REDIS_QUEUE_USERNAME=
# REDIS_QUEUE_PASSWORD=

# Set false when backups are managed outside this application.
BACKUP_SCHEDULE_ENABLED=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Optional real-time updates: set BROADCAST_CONNECTION=reverb and generate
# application credentials with php artisan reverb:install. Never expose the secret.
# Leave these absent until reverb:install generates them in your local .env.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false
# Restrict to the browser hostnames that may open the WebSocket in production
# (comma-separated, no scheme or port).
REVERB_ALLOWED_ORIGINS=*
REVERB_APP_RATE_LIMITING_ENABLED=true

# Browser-facing WebSocket endpoint, rendered at request time. Defaults to
# REVERB_*. Set these when the browser reaches Reverb through a different
# host/port, such as a container service name or a reverse proxy.
# REVERB_CLIENT_HOST=localhost
# REVERB_CLIENT_PORT=8080
# REVERB_CLIENT_SCHEME=http
